{
  "name": "@wow/desktop",
  "version": "0.3.4",
  "private": true,
  "description": "wow desktop app: calendar, agent chat, workflows and backlog in one window.",
  "author": "wow",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "test": "vitest run --dir src",
    "build": "pnpm --filter @wow/web build && node scripts/build.mjs",
    "smoke": "node scripts/smoke-server.mjs",
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "@types/ws": "8.18.2",
    "@wow/contracts": "workspace:*",
    "@wow/server": "workspace:*",
    "@wow/web": "workspace:*",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "electron-updater": "6.8.11",
    "esbuild": "0.28.2",
    "ws": "8.22.1",
    "yaml": "2.9.1",
    "zod": "^4.6.7"
  }
}
